{
    "listeners": {
        "*:80": {
            "pass": "routes"
        }
    },
    "routes": [
        {
            "action": {
                "share": "/var/www/html/public/",
                "fallback": {
                    "pass": "applications/laravel"
                }
            }
        }
    ],
    "applications": {
        "laravel": {
            "type": "php",
            "user": "unit",
            "group": "unit",
            "root": "/var/www/html/public",
            "script": "index.php",
            "options": {
                "admin": {}
            }
        }
    }
}