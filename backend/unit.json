{
    "listeners": {
        "*:80": {
            "application": "laravel"
        },
        "unix:/var/lib/unit/control.sock": {
             "pass": "applications"
        }
    },

    "applications": {
        "laravel": {
            "type": "php",
            "targets": {
                ".php": "/var/www/html/public/"
            },
            "user": "unit",
            "group": "unit",
            "root": "/var/www/html"
        }
    }
}
