{
    "listeners": {
        "*:80": {
            "pass": "applications/laravel"
        }
    },

    "applications": {
        "laravel": {
            "type": "php",
            "root": "/var/www/html/public",
            "script": "index.php"
        }
    },

    "settings": {
        "user": "unit",
        "group": "unit",
        "control_socket": "/var/lib/unit/control.sock"
    }
}
