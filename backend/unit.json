{
    "listeners": {
        "*:80": {
            "pass": "routes"
        }
    },
    "routes": [
        {
            "match": {
                "uri": [
                    "*.css",
                    "*.js",
                    "*.png",
                    "*.jpg",
                    "*.jpeg",
                    "*.gif",
                    "*.ico",
                    "*.svg",
                    "*.woff",
                    "*.woff2",
                    "*.ttf",
                    "*.eot",
                    "*.otf",
                    "*.map",
                    "/storage/*"
                ]
            },
            "action": {
                "share": "/var/www/html/public$uri",
                "fallback": {
                    "pass": "applications/laravel"
                }
            }
        },
        {
            "action": {
                "pass": "applications/laravel"
            }
        }
    ],
    "applications": {
        "laravel": {
            "type": "php",
            "user": "unit",
            "group": "unit",
            "root": "/var/www/html/public",
            "script": "index.php",
            "options": {
                "admin": {}
            }
        }
    }
}