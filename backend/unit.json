{
    "control": {
        "socket": "unix:/var/run/unit/control.sock"
    },

    "listeners": {
        "*:80": {
            "application": "laravel"
        }
    },

    "applications": {
        "laravel": {
            "type": "php",
            "targets": {
                ".php": "/var/www/html/public/"
            },
            "user": "unit",
            "group": "unit",
            "root": "/var/www/html"
        }
    }
}
